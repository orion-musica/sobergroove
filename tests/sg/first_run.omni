# First start: splash, intro, choosing Kit, the prologue, help, then home.
wait 500
expect screen 0
shot 01-splash.png
wait 3000
expect screen 1
shot 02-what.png
tap SEL
wait 100
shot 03-safety.png
tap SEL
wait 100
expect screen 3
turn SELECT 1
wait 100
shot 04-choose.png
tap SEL
wait 100
expect character 1
shot 05-knock.png
tap SEL
wait 100
shot 06-who.png
tap SEL
wait 100
shot 07-why.png
tap SEL
wait 100
shot 08-crash.png
tap SEL
wait 100
shot 09-thanks.png
tap SEL
wait 100
shot 10-road.png
tap SEL
wait 100
shot 11-help.png
tap SEL
wait 100
shot 12-ready.png
tap SEL
wait 1200
expect onboarded 1
expect screen 12
expect store_writes >0
shot 13-main.png
# first morning: hold HOME, no question the first time
press HOME
wait 1700
release HOME
wait 100
expect days 1
expect streak 1
shot 14-declared.png
tap SEL
wait 100
shot 15-thought.png
tap SEL
wait 100
expect screen 12
# care: meal
tapkey b0
wait 300
expect rhythm >60
shot 16-meal.png
wait 3000
# talk: rate 4
tapkey b1
wait 100
turn SELECT 1
shot 17-mood.png
tap SEL
wait 300
# status pages
tap HOME
wait 100
shot 18-status.png
tap HOME
wait 100
shot 19-next-stage.png
tap HOME
wait 100
expect screen 12
# same boot, a second hold: already counted
press HOME
wait 1700
release HOME
wait 100
expect days 1
shot 20-already.png
tap SEL
wait 1500
reboot
wait 3600
expect onboarded 1
expect days 1
expect character 1
expect screen 12
# after a reboot the buddy asks whether it is a new day
press HOME
wait 1700
release HOME
wait 100
shot 21-newday.png
tap SEL
wait 100
